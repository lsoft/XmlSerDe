<?xml version="1.0" encoding="utf-8"?>
<!--
  Чистый проект должен видеть только локальный фид с проверяемыми пакетами:
  иначе тест мог бы утащить одноимённый пакет с nuget.org и «пройти», не
  проверив ничего. nuget.org остаётся ради зависимостей (System.Memory и
  прочих на netstandard2.0).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="xmlserde-local" value="__PACKAGE_DIRECTORY__" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
